+bool IsLiveParameterSyncEnabled() {
+    static bool enabled = true;
+    static bool logged = false;
+    static auto next_poll = std::chrono::steady_clock::time_point{};
+    const auto now = std::chrono::steady_clock::now();
+    if (now < next_poll) {
+        return enabled;
+    }
+    next_poll = now + std::chrono::seconds{1};
+    std::ifstream control{Common::FS::GetEdenPath(Common::FS::EdenPath::ConfigDir) /
+                          "mh-rise-sync-control.txt"};
+    char mode{};
+    if (control.get(mode) && (mode == '0' || mode == '1')) {
+        const bool requested = mode == '1';
+        if (!logged || requested != enabled) {
+            LOG_WARNING(HW_GPU, "Live comparison: selective parameter readback enabled {}",
+                        requested);
+            logged = true;
+        }
+        enabled = requested;
+    }
+    return enabled;
+}
