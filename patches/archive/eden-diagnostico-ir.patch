+void DumpShaderIR(u64 shader_hash, const Shader::IR::Program& program) {
+    const auto& dump_dir = Common::FS::GetEdenPath(Common::FS::EdenPath::DumpDir);
+    const auto path = dump_dir / fmt::format("{:016x}_{:016x}.ir",
+                                           Settings::GetCurrentProgramID(), shader_hash);
+    const std::string text = Shader::IR::DumpProgram(program);
+    if (Common::FS::WriteStringToFile(path, Common::FS::FileType::TextFile, text) != text.size()) {
+        LOG_WARNING(Render_Vulkan, "Failed to dump shader IR {:016x}", shader_hash);
+    }
+}
