+bool HasAmbiguousPhiAddress(const IR::Value& value, const Bias& bias) {
+    if (value.IsImmediate()) {
+        return false;
+    }
+    small_vector<const IR::Inst*, 16> pending{value.InstRecursive()};
+    Common::unordered_set<const IR::Inst*> visited;
+    std::optional<StorageBufferAddr> first_buffer;
+    bool has_phi = false;
+    bool multiple_buffers = false;
+    while (!pending.empty()) {
+        const IR::Inst* const inst = pending.back();
+        pending.pop_back();
+        if (!visited.insert(inst).second) {
+            continue;
+        }
+        const IR::Opcode opcode = inst->GetOpcode();
+        has_phi |= opcode == IR::Opcode::Phi;
+        if (opcode == IR::Opcode::GetCbufU32 || opcode == IR::Opcode::GetCbufU32x2) {
+            const IR::Value index = inst->Arg(0);
+            const IR::Value offset = inst->Arg(1);
+            if (index.IsImmediate() && offset.IsImmediate()) {
+                const StorageBufferAddr buffer{index.U32(), offset.U32()};
+                if (MeetsBias(buffer, bias) && Common::IsAligned(buffer.offset, bias.alignment)) {
+                    if (first_buffer && *first_buffer != buffer) {
+                        multiple_buffers = true;
+                    }
+                    first_buffer = buffer;
+                }
+            }
+            continue;
+        }
+        if (IsGlobalMemory(*inst) || opcode == IR::Opcode::LoadStorage32 ||
+            opcode == IR::Opcode::LoadStorage64 || opcode == IR::Opcode::LoadStorage128 ||
+            opcode == IR::Opcode::LoadStorageU8 || opcode == IR::Opcode::LoadStorageS8 ||
+            opcode == IR::Opcode::LoadStorageU16 || opcode == IR::Opcode::LoadStorageS16) {
+            continue;
+        }
+        for (size_t arg = 0; arg < inst->NumArgs(); ++arg) {
+            const IR::Value operand = inst->Arg(arg);
+            if (!operand.IsImmediate()) {
+                pending.push_back(operand.InstRecursive());
+            }
+        }
+    }
+    return has_phi && multiple_buffers;
+}
