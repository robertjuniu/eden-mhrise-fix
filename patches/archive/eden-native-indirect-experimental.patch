+bool UseLowAccuracyIndirect(const Maxwell3D& maxwell3d, size_t word_count) {
+    if (Settings::IsGPULevelHigh() || (Settings::values.debug_knobs.GetValue() & 1024U) == 0) {
+        return false;
+    }
+    const GPUVAddr start = maxwell3d.GetMacroAddress(1);
+    if (start == 0) {
+        return false;
+    }
+    for (size_t index = 1; index < word_count; ++index) {
+        if (maxwell3d.GetMacroAddress(1 + index) != start + index * sizeof(u32)) {
+            return false;
+        }
+    }
+    return true;
+}
